{
  "archinstall-language": "English",
  "audio_config": {
    "audio": "pipewire"
  },
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "removable": false,
    "uki": false
  },
  "custom_commands": [
    "systemctl enable NetworkManager.service",
    "systemctl enable sddm.service",
    "systemctl enable bluetooth.service",
    "systemctl enable cups.service"
  ],
  "debug": false,
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/disk/by-id/REPLACE_WITH_TARGET_DISK",
        "partitions": [
          {
            "btrfs": [],
            "flags": [
              "boot"
            ],
            "fs_type": "fat32",
            "mount_options": [],
            "mountpoint": "/boot",
            "obj_id": "5c53d60c-5eac-45cc-a06a-d6e93d600ad1",
            "size": {
              "sector_size": null,
              "unit": "MiB",
              "value": 1024
            },
            "start": {
              "sector_size": null,
              "unit": "MiB",
              "value": 1
            },
            "status": "create",
            "type": "primary"
          },
          {
            "btrfs": [],
            "flags": [],
            "fs_type": "ext4",
            "mount_options": [],
            "mountpoint": "/",
            "obj_id": "22f7d265-f7cf-41d3-9ee0-0a968eeb89f3",
            "size": {
              "sector_size": null,
              "unit": "Percent",
              "value": 100
            },
            "start": {
              "sector_size": null,
              "unit": "MiB",
              "value": 1025
            },
            "status": "create",
            "type": "primary"
          }
        ],
        "wipe": true
      }
    ]
  },
  "hostname": "arch-kde",
  "kernels": [
    "linux",
    "linux-lts"
  ],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "mirror_config": {
    "mirror_regions": {
      "United States": []
    },
    "optional_repositories": [
      "multilib"
    ]
  },
  "network_config": {},
  "no_pkg_lookups": false,
  "ntp": true,
  "offline": false,
  "packages": [
    "base-devel",
    "bash-completion",
    "bluez",
    "bluez-utils",
    "cups",
    "dolphin",
    "firefox",
    "git",
    "htop",
    "kate",
    "konsole",
    "networkmanager",
    "networkmanager-qt",
    "reflector",
    "sudo",
    "vim",
    "wget"
  ],
  "parallel downloads": 5,
  "profile_config": {
    "gfx_driver": "All open-source (default)",
    "greeter": "sddm",
    "profile": {
      "details": [
        "KDE Plasma"
      ],
      "main": "Desktop"
    }
  },
  "script": "guided",
  "silent": true,
  "swap": {
    "algorithm": "zstd",
    "enabled": true
  },
  "timezone": "America/New_York"
}
